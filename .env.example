# API client scopes: NGSIEM Data Connections API (Read and Write), Correlation Rules (Read)
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# US-1: https://api.crowdstrike.com
# US-2: https://api.us-2.crowdstrike.com
# EU-1: https://api.eu-1.crowdstrike.com
# US-GOV-1: https://api.laggar.gcw.crowdstrike.com
FALCON_BASE_URL=https://api.crowdstrike.com

# Optional: only someone with this password can change the application settings.
APP_ADMIN_PASSWORD=

# Optional: the address and port the app listens on. The default, 127.0.0.1, accepts connections
# from this machine only. Set HOST=0.0.0.0 to accept connections from other machines, for example
# when the app runs on a server and you browse from a workstation. The app has no login, so only do
# that on a trusted network, behind a firewall rule, with APP_ADMIN_PASSWORD set.
HOST=127.0.0.1
PORT=5000
