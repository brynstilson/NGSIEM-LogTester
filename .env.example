# API client scopes: NGSIEM Data Connections API (Read and Write), Correlation Rules (Read)
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# US-1: https://api.crowdstrike.com
# US-2: https://api.us-2.crowdstrike.com
# EU-1: https://api.eu-1.crowdstrike.com
# US-GOV-1: https://api.laggar.gcw.crowdstrike.com
FALCON_BASE_URL=https://api.crowdstrike.com

# Optional: only someone with this password can change the application settings.
APP_ADMIN_PASSWORD=

# Optional: the address and port the app listens on. The default, 127.0.0.1, accepts connections
# from this machine only. Set HOST=0.0.0.0 to accept connections from other machines, for example
# when the app runs on a server and you browse from a workstation. The app then refuses to start
# unless APP_ACCESS_PASSWORD, APP_ADMIN_PASSWORD and APP_ALLOWED_HOSTS are all set.
HOST=127.0.0.1
PORT=5000

# Password every operator signs in with (the browser asks for it; the user name is recorded in the
# forensic log). Optional on localhost, required with HOST=0.0.0.0. Must differ from APP_ADMIN_PASSWORD.
APP_ACCESS_PASSWORD=

# Host names or IP addresses people type into the browser to reach this app, comma-separated, for
# example: 10.0.0.5,logtester.corp.example. localhost and 127.0.0.1 are always allowed. Other names
# are refused, which stops DNS rebinding attacks.
APP_ALLOWED_HOSTS=
